# AI 密钥环境变量示例（勿把真实密钥提交进仓库）
#
# 活跃三模型（复核/创造在用）
QIYU_DEEPSEEK_API_KEY=
QIYU_DEEPSEEK_MODEL=deepseek-v4-pro
QIYU_QWEN_API_KEY=
QIYU_QWEN_MODEL=qwen3.7-plus
QIYU_GLM_API_KEY=
QIYU_GLM_MODEL=glm-5.2
QIYU_GLM_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# Kimi K3（自定义提供商 cmkey，OpenAI 兼容）
# 创造管道职责：研究发现确定性门槛之后的独立裁判（ADMIT/REJECT → 是否交四阶段复核）
# - 填 QIYU_KIMI_API_KEY 后默认启用；显式 QIYU_KIMI_ENABLED=0 可关闭
# - Base URL 用 https://cmkey.cn/v1/chat/completions（非 Moonshot 官方域名）
# - 国内机请关代理；QIYU_FORCE_NO_PROXY=1 强制直连
QIYU_KIMI_API_KEY=
QIYU_KIMI_MODEL=kimi-k3
QIYU_KIMI_URL=https://cmkey.cn/v1/chat/completions
# 留空=有 Key 则启用；设 0 强制关闭
# QIYU_KIMI_ENABLED=
QIYU_FORCE_NO_PROXY=1
