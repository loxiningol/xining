# AI 密钥环境变量示例（勿把真实密钥提交进仓库）
#
# 活跃三模型（复核/创造在用）
QIYU_DEEPSEEK_API_KEY=
QIYU_DEEPSEEK_MODEL=deepseek-v4-pro
QIYU_QWEN_API_KEY=
QIYU_QWEN_MODEL=qwen3.7-plus
QIYU_GLM_API_KEY=
QIYU_GLM_MODEL=glm-5.2
QIYU_GLM_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# Kimi K3 待机（自定义提供商 cmkey，OpenAI 兼容）
# - Base URL 填 https://cmkey.cn ，实际请求用 https://cmkey.cn/v1/chat/completions
# - 非官方 Key：不要填 Moonshot 官方域名（api.moonshot.ai / .cn）
# - 国内机请关闭魔法/系统代理，直连 cmkey；QIYU_FORCE_NO_PROXY=1 强制不走代理
# - ENABLED=0：只预置，不参与复核/创造
QIYU_KIMI_API_KEY=
QIYU_KIMI_MODEL=kimi-k3
QIYU_KIMI_URL=https://cmkey.cn/v1/chat/completions
QIYU_KIMI_ENABLED=0
QIYU_FORCE_NO_PROXY=1
