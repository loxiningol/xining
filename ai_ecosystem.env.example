# Copy to /root/auto_trade/ai_ecosystem.env and chmod 600.
# Do not place OKX keys or SSH keys here.  The AI reviewers never receive them.
QIYU_DEEPSEEK_API_KEY=
QIYU_DEEPSEEK_MODEL=deepseek-v4-pro
QIYU_QWEN_API_KEY=
QIYU_QWEN_MODEL=qwen3.7-plus
QIYU_CHATGPT_API_KEY=
QIYU_CHATGPT_MODEL=gpt-5.2

# Six deterministic neighbors plus independently proposed AI variants, capped
# at twelve unique parameter sets per daily research tick.
QIYU_ECOSYSTEM_LOCAL_VARIANTS=6
QIYU_ECOSYSTEM_VARIANTS=12
# Non-converged AI ideas may consume at most six extra sandbox backtests and
# can never be promoted from this path.
QIYU_ECOSYSTEM_EXPLORATION_VARIANTS=6
QIYU_ECOSYSTEM_BACKTEST_START="2026-01-01 00:00:00"

# --- Research long candles (S3 / Cloudflare R2) — creation only ---
# Live formal_*_candles_cache.json stays short; do NOT enlarge it.
# QIYU_R2_ACCOUNT_ID=
# QIYU_R2_ACCESS_KEY_ID=
# QIYU_R2_SECRET_ACCESS_KEY=
# QIYU_R2_BUCKET=qiyu-research-candles
# QIYU_RESEARCH_CANDLES_MODE=auto
# QIYU_CREATION_PREFER_RESEARCH=1
# QIYU_RESEARCH_LOOKBACK_DAYS=400
# QIYU_CREATION_MAX_BARS=20000
# Local mirror when cloud keys absent:
# QIYU_RESEARCH_CANDLES_MODE=local
# QIYU_RESEARCH_LOCAL_ROOT=/root/auto_trade/research_candle_store

