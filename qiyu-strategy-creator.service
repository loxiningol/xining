[Unit]
Description=Qiyu continuous three-AI strategy creator
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root
Environment=VECTOR_ROOT=/root
Environment=QIYU_CREATOR_SLOT=0
EnvironmentFile=-/root/auto_trade/ai_ecosystem.env
ExecStart=/usr/bin/flock -n -E 75 /root/auto_trade/strategy_creator_slot0.lock /usr/bin/python3 /root/auto_trade_strategy_ecosystem.py --create-strategy
User=root
Nice=15
CPUAccounting=true
CPUQuota=70%
MemoryAccounting=true
MemoryHigh=520M
MemoryMax=650M
TimeoutStartSec=4h
SuccessExitStatus=75

[Install]
WantedBy=multi-user.target
